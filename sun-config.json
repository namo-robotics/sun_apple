{
  "root": true,
  "package_id": "namo-robotics/sun_apple",
  "steps": [
    {
      "name": "capture",
      "enabled": {
        "default": false,
        "target": {
          "arm64-apple-darwin": true
        }
      },
      "command": [
        "xcrun",
        "clang",
        "-fobjc-arc",
        "-mmacosx-version-min=15.2",
        "-c",
        "src/native/capture.m",
        "-o",
        "${SUN_BUILD}/native/capture.o"
      ],
      "inputs": [
        "src/native/capture.m"
      ],
      "outputs": [
        "${SUN_BUILD}/native/capture.o"
      ]
    },
    {
      "name": "movie",
      "enabled": {
        "default": false,
        "target": {
          "arm64-apple-darwin": true
        }
      },
      "command": [
        "xcrun",
        "clang",
        "-fobjc-arc",
        "-mmacosx-version-min=15.2",
        "-c",
        "src/native/movie.m",
        "-o",
        "${SUN_BUILD}/native/movie.o"
      ],
      "inputs": [
        "src/native/movie.m"
      ],
      "outputs": [
        "${SUN_BUILD}/native/movie.o"
      ]
    },
    {
      "name": "native",
      "enabled": {
        "default": false,
        "target": {
          "arm64-apple-darwin": true
        }
      },
      "requires": [
        "capture",
        "movie"
      ],
      "command": [
        "xcrun",
        "ar",
        "rcs",
        "${SUN_BUILD}/native/libsun_apple_native.a",
        "${SUN_BUILD}/native/capture.o",
        "${SUN_BUILD}/native/movie.o"
      ],
      "inputs": [
        "${SUN_BUILD}/native/capture.o",
        "${SUN_BUILD}/native/movie.o"
      ],
      "outputs": [
        "${SUN_BUILD}/native/libsun_apple_native.a"
      ]
    },
    {
      "name": "native_shared",
      "enabled": {
        "default": false,
        "target": {
          "arm64-apple-darwin": true
        }
      },
      "requires": [
        "capture",
        "movie"
      ],
      "command": [
        "xcrun",
        "clang",
        "-dynamiclib",
        "${SUN_BUILD}/native/capture.o",
        "${SUN_BUILD}/native/movie.o",
        "-mmacosx-version-min=15.2",
        "-install_name",
        "@rpath/libsun_apple_native.dylib",
        "-framework",
        "AppKit",
        "-framework",
        "ScreenCaptureKit",
        "-framework",
        "AVFoundation",
        "-framework",
        "CoreMedia",
        "-framework",
        "CoreGraphics",
        "-framework",
        "CoreVideo",
        "-framework",
        "CoreImage",
        "-framework",
        "ImageIO",
        "-o",
        "${SUN_BUILD}/native/libsun_apple_native.dylib"
      ],
      "inputs": [
        "${SUN_BUILD}/native/capture.o",
        "${SUN_BUILD}/native/movie.o"
      ],
      "outputs": [
        "${SUN_BUILD}/native/libsun_apple_native.dylib"
      ]
    }
  ],
  "entrypoints": [
    {
      "name": "sun_apple",
      "path": "src/sun_apple.sun",
      "type": "library",
      "export": true,
      "enabled": {
        "default": false,
        "target": {
          "arm64-apple-darwin": true
        }
      },
      "steps": [
        "native",
        "native_shared"
      ],
      "resources": [
        {
          "path": "${SUN_BUILD}/native/libsun_apple_native.a",
          "destination": "lib/native/libsun_apple_native.a"
        }
      ]
    },
    {
      "name": "bindings_smoke",
      "path": "tests/main.sun",
      "type": "binary",
      "export": false,
      "enabled": {
        "default": false,
        "target": {
          "arm64-apple-darwin": true
        }
      },
      "requires": [
        "sun_apple"
      ],
      "compile_args": [
        "--dynamic"
      ],
      "link_args": [
        "-lobjc",
        "-framework",
        "AppKit",
        "-framework",
        "ScreenCaptureKit",
        "-framework",
        "AVFoundation",
        "-framework",
        "CoreMedia",
        "-framework",
        "Foundation",
        "-framework",
        "CoreFoundation",
        "-framework",
        "CoreGraphics",
        "-framework",
        "CoreVideo",
        "-framework",
        "CoreImage",
        "-framework",
        "ImageIO"
      ]
    }
  ],
  "exports": [
    {
      "path": "LICENSE",
      "destination": "share/sun_apple/LICENSE"
    }
  ],
  "packages": [
    {
      "name": "sun_apple",
      "entrypoints": [
        "sun_apple"
      ],
      "resources": [
        {
          "path": "LICENSE",
          "destination": "share/sun_apple/LICENSE"
        },
        {
          "path": "${SUN_BUILD}/native/libsun_apple_native.a",
          "destination": "lib/native/libsun_apple_native.a"
        },
        {
          "path": "${SUN_BUILD}/native/libsun_apple_native.dylib",
          "destination": "lib/native/libsun_apple_native.dylib"
        }
      ]
    }
  ]
}
